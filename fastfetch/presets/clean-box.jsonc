{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch2",
        "color": {
            "1": "38;2;156;207;216"
        },
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " : ",
        "color": {
            "separator": "38;2;144;140;170"
        },
        "percent": {
            "type": 3
        },
        "bar": {
            "char": {
                "elapsed": "\u2588",
                "total": "\u2591"
            },
            "border": {
                "left": "[",
                "right": "]"
            },
            "color": {
                "elapsed": "38;2;156;207;216",
                "total": "38;2;64;61;82"
            },
            "width": 10
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "{#38;2;156;207;216}\u250c\u2500\u2500\u2500 {#38;2;224;222;244}SYSTEM INFO {#38;2;156;207;216}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510"
        },
        {
            "type": "title",
            "key": "{#38;2;156;207;216}\u2502 {#38;2;196;167;231}User",
            "format": "{user-name} @ {host-name}"
        },
        {
            "type": "os",
            "key": "{#38;2;156;207;216}\u2502 {#38;2;196;167;231}Distro",
            "format": "{3}"
        },
        {
            "type": "kernel",
            "key": "{#38;2;156;207;216}\u2502 {#38;2;196;167;231}Kernel"
        },
        {
            "type": "uptime",
            "key": "{#38;2;156;207;216}\u2502 {#38;2;196;167;231}Uptime"
        },
        {
            "type": "packages",
            "key": "{#38;2;156;207;216}\u2502 {#38;2;196;167;231}Packages"
        },
        {
            "type": "custom",
            "format": "{#38;2;156;207;216}\u251c\u2500\u2500\u2500 {#38;2;224;222;244}ENVIRONMENT {#38;2;156;207;216}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510"
        },
        {
            "type": "wm",
            "key": "{#38;2;156;207;216}\u2502 {#38;2;235;188;186}WM"
        },
        {
            "type": "terminal",
            "key": "{#38;2;156;207;216}\u2502 {#38;2;235;188;186}Terminal"
        },
        {
            "type": "shell",
            "key": "{#38;2;156;207;216}\u2502 {#38;2;235;188;186}Shell"
        },
        {
            "type": "display",
            "key": "{#38;2;156;207;216}\u2502 {#38;2;235;188;186}Display",
            "compactType": "original-with-refresh-rate"
        },
        {
            "type": "custom",
            "format": "{#38;2;156;207;216}\u251c\u2500\u2500\u2500 {#38;2;224;222;244}HARDWARE {#38;2;156;207;216}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510"
